# 🤖 AI Providers
# Primary / Fallback: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# IBM BOB watsonx.ai (Granite 13B & 20B)
WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_API_KEY=your_ibm_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# 💾 Database (MongoDB)
# If omitted in development, in-memory fallback is active. Required in production.
MONGO_URI=mongodb://localhost:27017/eduflow

# 🔐 Authentication & Security
# Required in production; dev fallback used if unset in development
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
CLIENT_URL=http://localhost:5173

# ⚙️ Server Configuration
PORT=5000
NODE_ENV=development

