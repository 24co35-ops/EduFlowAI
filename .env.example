# ---------------------------------------------------------------------------
# EduFlow AI — Environment Configuration Template
# ---------------------------------------------------------------------------

# 🤖 Primary AI Engine: IBM watsonx.ai (IBM Cloud Granite Models)
# Obtain from IBM Cloud: Cloud Pak for Data / watsonx.ai project settings
WATSONX_APIKEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_VERSION=2023-05-29

# IBM Granite Model IDs (environment-driven, configurable per project availability)
WATSONX_MODEL_TEXT=ibm/granite-13b-instruct-v2
WATSONX_MODEL_CHAT=ibm/granite-13b-chat-v2
WATSONX_MODEL_MULTILINGUAL=ibm/granite-20b-multilingual

# 🤖 Secondary/Alternative Granite Runner (Hugging Face Inference API)
# Optional: if IBM Cloud account is not available, IBM Granite can run via Hugging Face router
# Get a free token at: huggingface.co/settings/tokens (read access)
HF_API_TOKEN=your_huggingface_token_here
HF_GRANITE_MODEL=ibm-granite/granite-3.3-8b-instruct

# 🤖 Fallback Engine (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 🗄️ Database & Auth: Supabase Postgres
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # server-side only, never expose to browser

# 🌐 Frontend Supabase Configuration (Safe for browser exposure)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_public_anon_key_here  # public anon key

# 🔐 JWT Secret — MUST match your Supabase project's JWT secret
JWT_SECRET=your_supabase_jwt_secret_here

# ⚙️ Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# 📧 Email (optional — password resets)
# RESEND_API_KEY=your_resend_api_key_here
# SMTP_FROM=EduFlow AI <noreply@yourdomain.com>
