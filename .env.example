# 🤖 AI Provider (Google Gemini - fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 🗄️ Supabase Database & Auth (PRIMARY - replaces MongoDB)
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # server-side only, never expose to browser

# 🌐 Frontend Supabase Configuration (Safe for browser exposure)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_public_anon_key_here  # public anon key, safe to expose to browser

# 🔐 JWT Secret — MUST match your Supabase project's JWT secret
# Get from: Supabase Dashboard → Project Settings → API → JWT Settings → JWT Secret
JWT_SECRET=your_supabase_jwt_secret_here

# ⚙️ Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# 🤖 IBM Granite via Hugging Face (free — no IBM Cloud account needed)
# Get a free token at: huggingface.co/settings/tokens  (read access is enough)
HF_API_TOKEN=your_huggingface_token_here
HF_GRANITE_MODEL=ibm-granite/granite-3.3-8b-instruct   # or any other ibm-granite/* instruct model

# 📧 Email (optional — leave blank to use Ethereal console preview in dev)
# Resend (preferred for production — replaces Supabase's default mailer for password resets)
# RESEND_API_KEY=your_resend_api_key_here
# SMTP_FROM=EduFlow AI <noreply@yourdomain.com>   # must match a verified Resend sender domain
#
# Alternative: any SMTP provider
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=EduFlow AI <noreply@eduflow.ai>
