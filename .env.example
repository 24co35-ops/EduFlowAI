# 🤖 AI Provider (Google Gemini - fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 🗄️ Supabase Database & Auth (PRIMARY - replaces MongoDB)
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # server-side only, never expose to browser

# 🌐 Frontend Supabase Configuration (Safe for browser exposure)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_public_anon_key_here  # public anon key, safe to expose to browser

# 🔐 JWT Secret — MUST match your Supabase project's JWT secret
# Get from: Supabase Dashboard → Project Settings → API → JWT Settings → JWT Secret
JWT_SECRET=your_supabase_jwt_secret_here

# ⚙️ Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# 🤖 IBM watsonx.ai (Optional — enables IBM Granite models for AI features)
# IBM_API_KEY=your_ibm_api_key_here
# WATSONX_PROJECT_ID=your_watsonx_project_id
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_API_VERSION=2024-05-31
# WATSONX_MODEL_TEXT=ibm/granite-13b-instruct-v2
# WATSONX_MODEL_CHAT=ibm/granite-13b-chat-v2
# WATSONX_MODEL_MULTILINGUAL=ibm/granite-20b-multilingual

# 📧 Email (optional — leave blank to use Ethereal console preview in dev)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=EduFlow AI <noreply@eduflow.ai>
